# ==============================================================================
# CattleSense Docker & AWS VM Environment Configuration Template
# Copy this file to .env before running: docker compose up -d
# ==============================================================================

# Database Connection (Neon Cloud PostgreSQL Recommended)
# Example: postgresql://username:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT Authentication Secret Key (Minimum 32 characters)
JWT_SECRET_KEY=cattlesense-super-secret-jwt-token-key-2026-secure-32bytes

# Allowed Frontend Origins (Comma-separated or '*' for all)
# Example: https://cattlesense.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173,*

# Resend Email Service (For OTP & Password Resets)
RESEND_API_KEY=
RESEND_FROM_EMAIL=CattleSense <onboarding@resend.dev>
