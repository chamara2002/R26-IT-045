# ==============================================================================
# CattleSense Backend Environment Configuration Template
# ==============================================================================

# Server Port
PORT=5001

# Database Connection String (Neon PostgreSQL / Supabase / Cloud Postgres - Recommended)
# DATABASE_URL=postgresql://neondb_owner:your_password@ep-example-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Local PostgreSQL Fallback (used only if DATABASE_URL is not set)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cattlesense

# JWT Authentication Secret Key
JWT_SECRET_KEY=cattlesense-super-secret-jwt-token-key-2026-secure-32bytes

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Resend Email Service Configuration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=CattleSense <onboarding@resend.dev>
